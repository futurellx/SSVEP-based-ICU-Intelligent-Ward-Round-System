    <property name="styleSheet">
     <string notr="true">QLineEdit {background: #EEEEEE;
    border-radius: 12px;
    border: none;
font-family: PingFangSC, PingFang SC;
font-weight: 400;
font-size: 28px;
color: #010408;
line-height: 40px;
text-align: left;
font-style: normal;
}
QCheckBox {
    font-size: 20px;
    text-align: left;
    color: rgba(255, 255, 255, 1);
    background: transparent; /* 去掉文字后的背景 */
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px; /* 圆形 */
    border: 1px solid rgba(27, 149, 255, 1); /* 按钮内部边框颜色 */
    background-color: rgba(5, 38, 101, 1); /* 未点击时的内部颜色 */
}
QCheckBox::indicator:hover {
    border: 2px solid rgba(79, 151, 214, 1); /* 鼠标悬停时的边框颜色 */
    background-color: rgba(0, 35, 105, 0.8); /* 鼠标悬停时的内部颜色 */
}

QCheckBox::indicator:checked {
    border: 2px solid rgba(27, 149, 255, 1); /* 点击后边框颜色 */
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5,
                                fx: 0.5, fy: 0.5,
                                stop: 0 rgba(27, 149, 255, 1),
                                stop: 0.5 rgba(27, 149, 255, 1),
                                stop: 0.51 rgba(5, 38, 101, 1),
                                stop: 1 rgba(5, 38, 101, 1)); /* 填充一半效果 */
}

QCheckBox::indicator:checked:hover {
    border: 2px solid rgba(79, 151, 214, 1); /* 点击后且悬停时的边框颜色 */
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5,
                                fx: 0.5, fy: 0.5,
                                stop: 0 rgba(79, 151, 214, 1),
                                stop: 0.5 rgba(79, 151, 214, 1),
                                stop: 0.51 rgba(5, 38, 101, 1),
                                stop: 1 rgba(5, 38, 101, 1)); /* 点击后且悬停时填充效果 */
}

QCheckBox:pressed::indicator {
    background-color: rgba(27, 149, 255, 0.5); /* 按下时的内部颜色 */
    border: 2px solid rgba(27, 149, 255, 0.8); /* 按下时的边框颜色 */
}
QCheckBox:disabled {
    color: rgba(255, 255, 255, 1); /* 禁用时的文本颜色 */
}

QCheckBox:disabled::indicator {
    border: 2px solid rgba(27, 149, 255, 0.3); /* 禁用时的边框颜色 */
    background-color: rgba(5, 38, 101, 0.3); /* 禁用时的内部颜色 */
}</string>
    </property>
