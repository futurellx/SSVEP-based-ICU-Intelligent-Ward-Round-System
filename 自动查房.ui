      <string notr="true">
QPushButton {
    width: 136px;
    height: 44px;
    background: rgba(255, 255, 255, 230);
    border-radius: 8px;
}

QPushButton{
    width: 72px;
    height: 25px;
    font-family: PingFangSC, PingFang SC;
    font-weight: 500;
    font-size: 18px;
    color: rgba(48, 96, 255, 255);
    line-height: 25px;
    text-align: center;
    font-style: normal;
}
QPushButton:hover {
margin: 1px 0 0 1px; /* 向左下角移动1像素 */
}
QPushButton:pressed {
margin: 2px 0 0 2px; /* 向左下角移动2像素 */
}
