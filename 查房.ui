}
/* 设置整个表格的样式 */
QTableWidget {
    border: 1px solid #CCCCCC;
    background-color: #FFFFFF;
}

/* 设置表格项的样式 */
QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid #CCCCCC;
}

/* 设置表头的样式*/
QHeaderView::section {
    width: 130px;
    height: 30px;
    background: #2864FF;
    font-family: PingFangSC, PingFang SC;
    font-weight: 400;
    font-size: 18px;
    color: #FFFFFF;
    line-height: 25px;
    text-align: left;
    font-style: normal;
    padding: 5px;
}

/* 设置选中表格项的样式 */
QTableWidget::item {
    background-color: #091427;
    color: #FFFFFF;
    border: none;
}
QTableWidget::item:selected {
    background: #2864FF;
    opacity: 0.2;
    border: none;
}
/* 设置焦点表格项的样式 */
QTableWidget::item:focus {
    background-color: #2864FF;
    color: #FFFFFF;
}
QTableWidget QScrollBar:vertical{  
            border-radius:5px;
			min-width: 15px;
			max-width: 15px;
            background-color:rgb(255,255,255);
}
QTableWidget QScrollBar::handle:vertical{  
            border-radius:5px;
            border-radius:5px;
			min-height:50px;
			max-height:50px;
            background-color:rgb(40,100,255);}
