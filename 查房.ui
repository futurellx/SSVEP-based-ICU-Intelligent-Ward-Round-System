    <property name="styleSheet">
     <string notr="true">Q{background-image: url(:/多功能智能查房系统/编组 12 - 副本.png);}
QLabel {
    width: 87px;
    height: 28px;
    font-weight: 400;
    font-size: 20px;
    color: #FFFFFF;
    line-height: 28px;
    letter-spacing: 1px;
    text-align: left;
}
QLineEdit {
    width: 136px;
    height: 44px;
    background: #FFFFFF;
    border-radius: 8px;
font-weight: 400;
font-size: 24px;
color: white;
line-height: 28px;
letter-spacing: 1px;
text-align: left;
font-style: normal;
}


QLineEdit {
    width: 300px;
    height: 40px;
    background-color: rgba(0, 35, 105, 0.8);
    box-shadow: 0px 2px 4px 0px rgba(79, 151, 214, 0.33);
    border: 1px solid rgba(27, 149, 255, 1);
    border-radius: 5px;
    padding-left: 10px;
    padding-right: 10px;
    color: rgba(255, 255, 255, 1); /* 输入文本颜色 */
    font-size: 20px;
}

QLineEdit:hover {
    border: 2px solid rgba(79, 151, 214, 1); /* 鼠标悬停时的边框颜色 */
    box-shadow: 0px 4px 8px 0px rgba(79, 151, 214, 0.5); /* 鼠标悬停时的阴影效果 */
}

QLineEdit:focus {
    border: 3px solid rgba(27, 149, 255, 1); /* 获得焦点时的边框颜色 */
    box-shadow: 0px 4px 8px 0px rgba(27, 149, 255, 0.5); /* 获得焦点时的阴影效果 */
    background-color: rgba(0, 35, 105, 1); /* 聚焦时背景变为不透明 */
}

QLineEdit:disabled {
    background-color: rgba(0, 35, 105, 0.3); /* 禁用时的背景颜色 */
    border: 1px solid rgba(27, 149, 255, 0.3); /* 禁用时的边框颜色 */
    color: rgba(152, 207, 255, 0.5); /* 禁用时的文本颜色 */
}

QLineEdit:focus:!hover {
    background-color: rgba(0, 35, 105, 0.9); /* 聚焦时没有悬停时背景色 */
}

QLineEdit:invalid {
    border: 1px solid rgba(255, 0, 0, 1); /* 输入无效时的边框颜色 */
    box-shadow: 0px 4px 8px 0px rgba(255, 0, 0, 0.5); /* 输入无效时的阴影效果 */
}


QRadioButton {
    font-size: 20px;
    text-align: left;
    color: rgba(255, 255, 255, 1);
    background: transparent; /* 去掉文字后的背景 */
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px; /* 圆形 */
    border: 1px solid rgba(27, 149, 255, 1); /* 按钮内部边框颜色 */
    background-color: rgba(5, 38, 101, 1); /* 未点击时的内部颜色 */
}

QRadioButton::indicator:hover {
    border: 2px solid rgba(79, 151, 214, 1); /* 鼠标悬停时的边框颜色 */
    background-color: rgba(0, 35, 105, 0.8); /* 鼠标悬停时的内部颜色 */
}

QRadioButton::indicator:checked {
    border: 2px solid rgba(27, 149, 255, 1); /* 点击后边框颜色 */
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5,
                                fx: 0.5, fy: 0.5,
                                stop: 0 rgba(27, 149, 255, 1),
                                stop: 0.5 rgba(27, 149, 255, 1),
                                stop: 0.51 rgba(5, 38, 101, 1),
                                stop: 1 rgba(5, 38, 101, 1)); /* 填充一半效果 */
}

QRadioButton::indicator:checked:hover {
    border: 2px solid rgba(79, 151, 214, 1); /* 点击后且悬停时的边框颜色 */
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5,
                                fx: 0.5, fy: 0.5,
                                stop: 0 rgba(79, 151, 214, 1),
                                stop: 0.5 rgba(79, 151, 214, 1),
                                stop: 0.51 rgba(5, 38, 101, 1),
                                stop: 1 rgba(5, 38, 101, 1)); /* 点击后且悬停时填充效果 */
}

QRadioButton:pressed::indicator {
    background-color: rgba(27, 149, 255, 0.5); /* 按下时的内部颜色 */
    border: 2px solid rgba(27, 149, 255, 0.8); /* 按下时的边框颜色 */
}

QRadioButton:disabled {
    color: rgba(255, 255, 255, 1); /* 禁用时的文本颜色 */
}

QRadioButton:disabled::indicator {
    border: 2px solid rgba(27, 149, 255, 0.3); /* 禁用时的边框颜色 */
    background-color: rgba(5, 38, 101, 0.3); /* 禁用时的内部颜色 */
}

</string>
