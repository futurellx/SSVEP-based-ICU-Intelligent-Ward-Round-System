     <widget class="QDateEdit" name="date_edit_start">
      <property name="geometry">
       <rect>
        <x>140</x>
        <y>110</y>
        <width>131</width>
        <height>31</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">QDateEdit {
    width: 300px;
    height: 40px;
    background-color: rgba(0, 35, 105, 0);
    box-shadow: 0px 2px 4px 0px rgba(79, 151, 214, 0.33);
    border: 1px solid rgba(27, 149, 255, 1);
    border-radius: 5px;
    padding-left: 10px;
    padding-right: 10px;
    color: rgba(255, 255, 255, 1); /* 输入文本颜色 */
    font-size: 16px;
}

QDateEdit:hover {
    border: 2px solid rgba(79, 151, 214, 1); /* 鼠标悬停时的边框颜色 */
    box-shadow: 0px 4px 8px 0px rgba(79, 151, 214, 0.5); /* 鼠标悬停时的阴影效果 */
}

QDateEdit:focus {
    border: 3px solid rgba(27, 149, 255, 1); /* 获得焦点时的边框颜色 */
    box-shadow: 0px 4px 8px 0px rgba(27, 149, 255, 0.5); /* 获得焦点时的阴影效果 */
    background-color: rgba(0, 35, 105, 1); /* 聚焦时背景变为不透明 */
}

QDateEdit:disabled {
    background-color: rgba(0, 35, 105, 0.3); /* 禁用时的背景颜色 */
    border: 1px solid rgba(27, 149, 255, 0.3); /* 禁用时的边框颜色 */
    color: rgba(152, 207, 255, 0.5); /* 禁用时的文本颜色 */
}

QDateEdit:focus:!hover {
    background-color: rgba(0, 35, 105, 0.9); /* 聚焦时没有悬停时背景色 */
}

QDateEdit:invalid {
    border: 1px solid rgba(255, 0, 0, 1); /* 输入无效时的边框颜色 */
    box-shadow: 0px 4px 8px 0px rgba(255, 0, 0, 0.5); /* 输入无效时的阴影效果 */
}
</string>
      </property>
     </widget>
